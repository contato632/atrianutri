{
  "name": "atrianutri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AtriaNutri — acompanhamento nutricional independente da AtriaCare",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "test:integration:local": "node scripts/supabase-integration-test.mjs",
    "test:homologation-runner": "node --test scripts/claude-homologation-runner.node-test.mjs",
    "homologation:claude": "node scripts/claude-homologation-runner.mjs",
    "catalog:import:usda": "node scripts/import-usda-fooddata.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:reset": "supabase db reset",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "jspdf": "4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "supabase": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
